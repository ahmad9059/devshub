# Neon pooled connection string. Keep credentials server-only.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# AWS S3 image uploads. The IAM principal should only access this bucket/prefix.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"
AWS_S3_BUCKET="devshub-images"

# Auth.js v5. AUTH_SECRET must be at least 32 characters — generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-min-32-char-random-secret"
AUTH_URL="http://localhost:3000"

# OAuth providers. Create credentials at:
#   https://console.cloud.google.com/apis/credentials
#   https://github.com/settings/developers
# For local dev, set authorized redirect URIs to http://localhost:3000/api/auth/callback/google and /github.
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"
GITHUB_CLIENT_ID="replace-me"
GITHUB_CLIENT_SECRET="replace-me"

# Cloudflare Turnstile bot protection. Create a site key + secret at:
#   https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY="replace-me"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="replace-me"
